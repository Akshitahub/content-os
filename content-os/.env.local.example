# ============================================================
# SocioPosts environment variables
#
# Copy this file to .env.local and fill in real values there.
# .env.local (and every other .env* file except this example) is
# gitignored — never commit real secrets. See README.md for what to do
# if a real secret was ever accidentally committed in the past.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are exposed to
# the browser by design (the NEXT_PUBLIC_ prefix) — this is only safe
# because Row Level Security is enabled on every table (see
# supabase/migrations/*.sql). Never disable RLS on a table without adding
# an equivalent server-side check.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS entirely — server-side only
# (lib/supabase/server.ts's createAdminClient). NEVER prefix this with
# NEXT_PUBLIC_ or reference it from a "use client" component.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI generation (Groq) — server-side only ─────────────────
GROQ_API_KEY=

# ── NVIDIA NIM — server-side only, never expose to client ───
# Get yours at https://build.nvidia.com — free tier available, no credit card required.
# Models used: extraction (llama-3.1-8b), generation (nemotron-70b), scoring (llama-3.3-70b)
NVIDIA_API_KEY=

# Image generation: Free-plan users get Pollinations.AI
# (https://pollinations.ai) — completely free, no API key needed. Every paid
# tier (Starter/Pro/Agency) and the internal owner-bypass get Replicate's
# Flux 2 Pro instead (lib/ai/post-image-pipeline.ts's resolveImageProvider).
# ── Replicate — server-side only ──────────────────────────────
# Get yours at https://replicate.com/account/api-tokens. Paid-tier post
# images return a clear "not configured" error until this is set — Free
# plan is unaffected (still Pollinations).
REPLICATE_API_TOKEN=

# ── Background removal — server-side only ────────────────────
REMOVE_BG_API_KEY=

# ── Apify (real Instagram hashtag discovery) — server-side only ─
# Get yours at https://console.apify.com/settings/integrations. Powers
# lib/ai/apify-hashtag-scraper.ts, which replaced influencer discovery's
# old LLM-invented-handle approach with real, currently-active accounts
# scraped from real hashtags (apidojo/instagram-hashtag-scraper actor).
# Apify gives $5/month free platform credit, which comfortably covers this
# app's realistic usage (a handful of discovery runs per brand, not
# continuous traffic) most months. Without this set, discovery logs a
# clear "not configured" error and returns no candidates -- never falls
# back to inventing handles.
APIFY_API_TOKEN=

# ── Kling AI — server-side only, never expose to client ──────
# Powers real AI video reel generation (lib/video/kling-client.ts), via
# PiAPI. Reel video generation returns a clear "not configured" error until
# this is set.
KLING_API_KEY=
# Shared secret PiAPI echoes back verbatim in the x-webhook-secret header
# on every Kling task webhook callback (app/api/v1/webhooks/kling/route.ts)
# — this is how that route verifies a callback genuinely came from PiAPI.
# Any long random string works; it just needs to match what's configured
# here and what gets sent to PiAPI on task submission (same value, both
# sides). Reel video generation is submitted but will never complete
# (stuck at "generating…") until this is set, since PiAPI's webhook won't
# be trusted without it.
KLING_WEBHOOK_SECRET=

# ── JSON2Video — server-side only, never expose to client ─────
# Renders the final reel video from Kling scene clips + TTS voiceover +
# music (lib/video/render-trigger.ts). Reel video generation will get
# through scene generation but never finish rendering until this is set.
JSON2VIDEO_API_KEY=
# JSON2Video does NOT sign its webhooks at all — confirmed via their own
# docs ("Webhooks are not currently signed by JSON2Video"). Their own
# recommendation is an unguessable token in the endpoint URL, which is what
# this is: appended as a ?token= query param on the webhook endpoint
# registered with JSON2Video (app/api/v1/webhooks/json2video/route.ts),
# checked on receipt. Combined with a project-id match and a mandatory
# re-fetch of the render's authoritative status before trusting any
# callback — see that route for all three layers. Any long random string
# works; it just needs to match between here and what's sent to JSON2Video.
JSON2VIDEO_WEBHOOK_SECRET=

# ── Zernio — unified social publishing API, server-side only ─
# Powers LinkedIn/YouTube/Twitter publishing (Pro/Agency plans).
ZERNIO_API_KEY=

# ── Meta (Instagram/Facebook) OAuth — server-side only ───────
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

# ── Pinterest OAuth — server-side only ────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Threads OAuth — server-side only ──────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── Razorpay billing ───────────────────────────────────────────
# RAZORPAY_KEY_ID is safe to return to the client (it's the equivalent of
# Stripe's publishable key, used to open the Razorpay checkout widget) —
# see app/api/v1/billing/create-checkout-session/route.ts. It is still kept
# as a server-side env var here rather than NEXT_PUBLIC_ since the server
# is the one that hands it to the client per-request.
# RAZORPAY_KEY_SECRET must NEVER be sent to the client — used only for
# order creation and HMAC signature verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret for the server-to-server webhook (Razorpay Dashboard ->
# Settings -> Webhooks -> set the URL to <your-domain>/api/v1/billing/webhook,
# subscribe to payment.captured, and copy the secret it gives you here — it
# is NOT the same value as RAZORPAY_KEY_SECRET). Without this set, the
# webhook route fails closed with a clear "not configured" error rather than
# silently accepting unverified requests.
RAZORPAY_WEBHOOK_SECRET=

# ── TathaAstu (Indian festival dates) — server-side only ──────
# Get yours at https://tathaastuapi.com — free tier (1,000 requests/month)
# is more than enough here; only app/api/v1/cron/refresh-festival-dates
# ever calls this, once a year. Without this set, that cron logs a clear
# "not configured" error and every festival falls back to its static
# fallbackDate in lib/occasions/festival-catalog.ts (approximate for
# lunar/lunisolar festivals, not wrong-by-omission) rather than the app
# breaking.
TATHAASTU_API_KEY=

# ── Cron authentication — server-side only ────────────────────
# Shared secret for app/api/v1/cron/* routes (Vercel Cron sends this as a
# Bearer token or ?secret= query param).
CRON_SECRET=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Internal/owner bypass — server-side only ───────────────────
# Comma-separated Supabase auth user IDs (uuid, from the "users" table —
# NOT emails) that get unlimited access: no generation-credit quota, no
# reel-quota, no brand/product caps, no Autopilot tier scaling, no
# Pro/Agency-only social-platform gating. Purely a runtime bypass layered
# on top of normal plan enforcement — does not touch the users.plan column,
# PLAN_LIMITS, or any billing/webhook logic. Leave empty in normal
# environments. Requires a redeploy to take effect (env vars are read at
# module load, not hot-reloaded).
INTERNAL_UNLIMITED_USER_IDS=

# ── Resend (transactional email) — server-side only ───────────
RESEND_API_KEY=

# ── PostHog (analytics) ────────────────────────────────────────
# Public by design — PostHog's client-side key is meant to be exposed.
NEXT_PUBLIC_POSTHOG_KEY=
